# HeatGuard Device Gateway Configuration

HOST=0.0.0.0
PORT=8001

# Adapter selection: simulator
ADAPTER=simulator
SIM_SEED_FILE=seed/devices.yaml

# Security tokens (never commit production secrets)
MCP_AUTH_TOKEN=dev-mcp-token-secret
ADMIN_TOKEN=dev-admin-token-secret
APPROVAL_SIGNING_SECRET=dev-approval-signing-secret-key-32chars
TOKEN_MAX_AGE_S=600

# Fault injection (true for testing, false for strict production)
FAULTS_ENABLED=true
FAULT_PROFILE=happy
FAULT_SEED=42

# Logging
LOG_LEVEL=INFO
IDEMPOTENCY_DB_PATH=idempotency.db
